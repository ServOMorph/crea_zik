{
  "schema_version": 1,
  "plugin_id": "kick",
  "name": "Kick",
  "version": "v0.1.0",
  "kind": "one_shot",
  "engine": {"module": "engine", "function": "render", "sample_rate": 48000},
  "parameter_groups": [
    {
      "id": "corps",
      "label": "Corps",
      "parameters": [
        {"id": "pitch_start", "type": "float", "unit": "hz", "curve": "exponential", "min": 20.0, "max": 500.0, "default": 150.0},
        {"id": "pitch_end", "type": "float", "unit": "hz", "curve": "exponential", "min": 20.0, "max": 500.0, "default": 45.0},
        {"id": "pitch_decay", "type": "float", "unit": "s", "curve": "exponential", "min": 0.001, "max": 2.0, "default": 0.05},
        {"id": "pitch_curve", "type": "enum", "values": ["exponential", "linear"], "default": "exponential"},
        {"id": "body_waveform", "type": "enum", "values": ["sine", "triangle"], "default": "sine"},
        {"id": "body_decay", "type": "float", "unit": "s", "curve": "exponential", "min": 0.01, "max": 3.0, "default": 0.35},
        {"id": "body_curve", "type": "enum", "values": ["exponential", "linear"], "default": "exponential"},
        {"id": "phase_start", "type": "float", "unit": "rad", "curve": "linear", "min": 0.0, "max": 6.283185307179586, "default": 0.0}
      ]
    },
    {
      "id": "sub",
      "label": "Sub",
      "parameters": [
        {"id": "sub_enabled", "type": "bool", "default": true},
        {"id": "sub_freq", "type": "int", "unit": "midi_note", "curve": "linear", "min": 0, "max": 60, "default": 30},
        {"id": "sub_decay", "type": "float", "unit": "s", "curve": "exponential", "min": 0.01, "max": 3.0, "default": 0.6},
        {"id": "sub_gain", "type": "float", "unit": "linear_gain", "curve": "linear", "min": 0.0, "max": 2.0, "default": 0.6},
        {"id": "sub_drive", "type": "float", "unit": "ratio", "curve": "linear", "min": 0.0, "max": 1.0, "default": 0.2}
      ]
    },
    {
      "id": "transitoire",
      "label": "Transitoire",
      "parameters": [
        {"id": "click_type", "type": "enum", "values": ["noise", "sine", "impulse"], "default": "noise"},
        {"id": "click_frequency", "type": "float", "unit": "hz", "curve": "exponential", "min": 200.0, "max": 4000.0, "default": 1200.0},
        {"id": "click_decay", "type": "float", "unit": "s", "curve": "exponential", "min": 0.0005, "max": 0.05, "default": 0.006},
        {"id": "click_gain", "type": "float", "unit": "linear_gain", "curve": "linear", "min": 0.0, "max": 2.0, "default": 0.6},
        {"id": "click_highpass", "type": "float", "unit": "hz", "curve": "exponential", "min": 20.0, "max": 4000.0, "default": 800.0}
      ]
    },
    {
      "id": "bruit",
      "label": "Bruit",
      "parameters": [
        {"id": "noise_gain", "type": "float", "unit": "linear_gain", "curve": "linear", "min": 0.0, "max": 1.0, "default": 0.15},
        {"id": "noise_filter", "type": "float", "unit": "hz", "curve": "exponential", "min": 20.0, "max": 8000.0, "default": 400.0},
        {"id": "noise_decay", "type": "float", "unit": "s", "curve": "exponential", "min": 0.001, "max": 0.5, "default": 0.03}
      ]
    },
    {
      "id": "sortie",
      "label": "Sortie",
      "parameters": [
        {"id": "drive_amount", "type": "float", "unit": "ratio", "curve": "linear", "min": 0.0, "max": 1.0, "default": 0.15},
        {"id": "output_gain", "type": "float", "unit": "linear_gain", "curve": "linear", "min": 0.0, "max": 2.0, "default": 1.0},
        {"id": "pan", "type": "float", "unit": "pan", "curve": "linear", "min": -1.0, "max": 1.0, "default": 0.0},
        {"id": "length", "type": "float", "unit": "s", "curve": "linear", "min": 0.05, "max": 4.0, "default": 1.2},
        {"id": "target_peak_dbfs", "type": "float", "unit": "dbfs", "curve": "linear", "min": -24.0, "max": -0.1, "default": -1.0},
        {"id": "seed", "type": "int", "unit": "integer", "curve": "linear", "min": 0, "max": 2147483647, "default": 0}
      ]
    }
  ],
  "presets": ["techno", "808_sub", "acoustique"]
}
