{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crea-zik/plugin-manifest/v1",
  "title": "Manifeste de plugin d'instrument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugin_id", "name", "version", "kind", "engine", "parameter_groups", "presets"],
  "properties": {
    "schema_version": {"const": 1},
    "plugin_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"enum": ["one_shot"]},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "function", "sample_rate"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "sample_rate": {"type": "integer", "minimum": 1}
      }
    },
    "parameter_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "parameters"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "parameters": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/parameter"}
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "default"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["float", "int", "bool", "enum"]},
        "unit": {"type": "string"},
        "curve": {"enum": ["linear", "exponential"]},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "default": {},
        "values": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "enum"}}, "required": ["type"]},
          "then": {"required": ["values"]}
        },
        {
          "if": {"properties": {"type": {"enum": ["float", "int"]}}, "required": ["type"]},
          "then": {"required": ["min", "max", "unit", "curve"]}
        }
      ]
    }
  }
}
