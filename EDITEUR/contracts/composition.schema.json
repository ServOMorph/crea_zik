{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crea-zik.local/contracts/composition.schema.json",
  "title": "Composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "revision", "title", "seed", "sample_rate", "tempo_bpm", "time_signature", "tracks", "patterns", "clips", "mixer", "render_settings"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 0},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "sample_rate": {"type": "integer", "enum": [44100, 48000, 88200, 96000]},
    "tempo_bpm": {"type": "number", "minimum": 20, "maximum": 400},
    "time_signature": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 1, "maximum": 32}, {"type": "integer", "enum": [1, 2, 4, 8, 16]}],
      "items": false
    },
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}, "minItems": 1},
    "patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
    "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}},
    "mixer": {"$ref": "#/$defs/mixer"},
    "render_settings": {"$ref": "#/$defs/renderSettings"}
  },
  "$defs": {
    "id": {"type": "string", "format": "uuid"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "gain", "pan", "instrument", "processors"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "kind": {"enum": ["drums", "bass", "pad", "arp", "lead", "audio", "midi"]},
        "gain": {"type": "number", "minimum": 0, "maximum": 2},
        "pan": {"type": "number", "minimum": -1, "maximum": 1},
        "instrument": {"type": "object"},
        "processors": {"type": "array", "items": {"type": "object"}}
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "track_id", "events"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "track_id": {"$ref": "#/$defs/id"},
        "events": {"type": "array", "items": {"type": "object"}}
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern_id", "start_beat", "length_beats"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "pattern_id": {"$ref": "#/$defs/id"},
        "start_beat": {"type": "number", "minimum": 0},
        "length_beats": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "mixer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master_gain", "limiter", "effects"],
      "properties": {
        "master_gain": {"type": "number", "minimum": 0, "maximum": 2},
        "limiter": {"type": "object"},
        "effects": {"type": "array", "items": {"type": "object"}}
      }
    },
    "renderSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "format", "channels"],
      "properties": {
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 7200},
        "format": {"enum": ["wav_pcm24", "wav_pcm16", "wav_float32"]},
        "channels": {"const": 2}
      }
    }
  }
}
